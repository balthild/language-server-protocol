{
	"name": "balthild/language-server-protocol",
	"type": "library",
	"description": "Langauge Server Protocol for PHP (transpiled)",
	"license": "MIT",
	"authors": [
		{
			"name": "Balthild",
			"email": "ibalthild@gmail.com"
		},
		{
			"name": "Daniel Leech",
			"email": "daniel@dantleech.com"
		}
	],
	"require": {
		"php": "^8.1"
	},
	"require-dev": {
		"ergebnis/composer-normalize": "^2.0",
		"phpstan/phpstan": "^2.0",
		"phpunit/phpunit": "^9.2"
	},
	"autoload": {
		"psr-4": {
			"Phpactor\\LanguageServerProtocol\\": "lib/",
			"Phpactor\\LanguageServerProtocol\\Support\\": "src/Support"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Phpactor\\LanguageServerProtocol\\Tests\\": "tests/"
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"scripts": {
		"integrate": [
			"./vendor/bin/phpunit",
			"./vendor/bin/phpstan analyze"
		]
	},
	"extra": {
		"branch-alias": {
			"dev-master": "0.3.x-dev"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true
		}
	}
}
